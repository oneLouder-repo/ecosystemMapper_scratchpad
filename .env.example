# Copy to .env and fill in. Every setting has a default that works on localhost.

# The platform's own domain. Orgs get subdomains: riverbend.<BASE_DOMAIN>.
BASE_DOMAIN=localhost
PORT=5173
# production turns on https cookies and turns off dev sign-in and the example orgs.
# NODE_ENV=production

# You, the platform admin.
SUPER_ADMIN_EMAIL=admin@localhost
SUPER_ADMIN_NAME=Platform admin
# SUPER_ADMIN_PASSWORD=choose-a-long-one

# Sign-in with other accounts (optional). Each is on once both of its keys are set.
# Redirect URI for each: <scheme>://<BASE_DOMAIN>[:PORT]/auth/<google|facebook|microsoft>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Signing up for a Free org from the platform's own site (on by default).
# OPEN_SIGNUP=true

# Custom domains (Custom plan). Orgs point a CNAME at this name; the platform's domain if not set.
# DNS_TARGET=sites.dashi.ca
# On Fly.io, these let the platform ask for each verified domain's certificate itself.
# FLY_API_TOKEN=
# FLY_APP_NAME=

# Behind a host's proxy (Fly.io, Render, Caddy, a load balancer): read visitors' addresses from it.
# TRUST_PROXY=true
# Days of daily database snapshots to keep in data/backups.
# BACKUP_DAYS=14

# Where the database and uploads live. Back this folder up.
# DATA_DIR=data
# Largest single upload (sent in 8 MB chunks), and storage per org.
# MAX_UPLOAD_MB=700
# ORG_STORAGE_MB=20480

# Test helpers (on by default except in production). SEED_EXAMPLES adds the six test orgs
# and their documents to a new, empty database.
# DEV_LOGIN=true
# SEED_EXAMPLES=true
