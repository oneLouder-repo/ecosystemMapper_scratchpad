# Copy to .env and fill in. Every setting has a default that works on localhost.

# The platform's own domain. Orgs get subdomains: riverbend.<BASE_DOMAIN>.
BASE_DOMAIN=localhost
PORT=5173
# production turns on https cookies and turns off dev sign-in and the example orgs.
# NODE_ENV=production

# You, the platform admin.
SUPER_ADMIN_EMAIL=admin@localhost
SUPER_ADMIN_NAME=Platform admin
# SUPER_ADMIN_PASSWORD=choose-a-long-one

# Google sign-in (optional). Redirect URI: <scheme>://<BASE_DOMAIN>[:PORT]/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Where the database and uploads live. Back this folder up.
# DATA_DIR=data
# MAX_UPLOAD_MB=300

# Test helpers (on by default except in production).
# DEV_LOGIN=true
# SEED_EXAMPLES=true
