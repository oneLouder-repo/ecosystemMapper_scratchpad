# Copy to .env and fill in. Every setting has a default that works on localhost.

# The platform's own domain. Orgs get subdomains: riverbend.<BASE_DOMAIN>.
BASE_DOMAIN=localhost
PORT=5173
# production turns on https cookies and turns off dev sign-in and the example orgs.
# NODE_ENV=production

# You, the platform admin.
SUPER_ADMIN_EMAIL=admin@localhost
SUPER_ADMIN_NAME=Platform admin
# SUPER_ADMIN_PASSWORD=choose-a-long-one

# Sign-in with other accounts (optional). Each is on once both of its keys are set.
# Redirect URI for each: <scheme>://<BASE_DOMAIN>[:PORT]/auth/<google|facebook|microsoft>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Where the database and uploads live. Back this folder up.
# DATA_DIR=data
# Largest single upload (sent in 8 MB chunks), and storage per org.
# MAX_UPLOAD_MB=700
# ORG_STORAGE_MB=20480

# Test helpers (on by default except in production).
# DEV_LOGIN=true
# SEED_EXAMPLES=true
